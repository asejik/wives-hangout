# All of these are SERVER-SIDE ONLY. Never prefix a secret with VITE_.
# Set them in Vercel → Project → Settings → Environment Variables.
#
# ONE Supabase project holds everything; rows are kept apart by EVENT_SLUG:
#   local + Preview:  EVENT_SLUG=wives-hangout-2026-dev  EMAIL_MODE=log
#   Production:       EVENT_SLUG=wives-hangout-2026      EMAIL_MODE=smtp
# The server refuses a -dev slug in production, and a non -dev slug anywhere else.
# The secret key is a PRODUCTION key even on a laptop: only ever delete or load-test dev-slug rows.

# Supabase (Project Settings → API Keys). Use the SECRET key (sb_secret_…), never the publishable one.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
EVENT_SLUG=wives-hangout-2026-dev

# Gmail SMTP (church Gmail + app password, shared with The Awakening)
SMTP_USER=
SMTP_PASS=
EMAIL_MODE=log          # log | smtp (production refuses log)

# Optional: absolute site URL for email images and links. On Vercel the production domain is
# detected automatically (VERCEL_PROJECT_PRODUCTION_URL); set this for local SMTP tests.
SITE_URL=

# Shared with the Apps Script trigger that calls /api/email-retry
RETRY_SECRET=

# Registration window: ISO 8601 WITH an offset (the server rejects anything else).
# No opening time (open as soon as configured). Closes Tue 20 Oct 2026, 11:59 PM WAT (builder, 2026-10-20).
REGISTRATION_OPENS_AT=
REGISTRATION_CLOSES_AT=2026-10-20T23:59:00+01:00
